# Real-Time Collaborative Workspace - Environment Variables (Placeholder Example)
# Copy this file to .env.local for local development. Never commit sensitive secrets to Git.

# PostgreSQL Database Connection String (used by Prisma ORM)
DATABASE_URL="postgresql://username:password@localhost:5432/collab_workspace?schema=public"

# Authentication Secret (Used for session / JWT encryption)
AUTH_SECRET="change-this-to-a-secure-random-32-byte-secret"

# Public URL of the Next.js Frontend Web Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Public WebSocket Collaboration Server URL (y-websocket)
NEXT_PUBLIC_COLLAB_URL="ws://localhost:1234"

# WebSocket Server Port (Local Node.js collaboration service)
COLLAB_PORT=1234

# Redis URL (Used for multi-instance scaling and pub/sub broadcast)
REDIS_URL="redis://localhost:6379"

