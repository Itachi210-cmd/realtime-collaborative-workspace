# Real-Time Collaborative Workspace - Environment Variables (Placeholder Template)
# Copy this file to .env.local for local development.
# NEVER commit real secrets, production credentials, or .env.local files to Git.

# ==============================================================================
# 1. REQUIRED SERVER SECRETS (Private — never expose with NEXT_PUBLIC_ prefix)
# ==============================================================================

# [REQUIRED] PostgreSQL connection string used by Prisma ORM and collaboration persistence
# Production example (Neon/PgBouncer): postgresql://user:pass@ep-host-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://username:password@localhost:5432/collab_workspace?schema=public"

# [REQUIRED] Primary JWT signing secret (HS256) for HTTP-only session cookies and collab tokens.
# Must be a high-entropy random string of at least 32 characters.
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="change-this-to-a-secure-random-32-byte-secret"

# [REQUIRED] Dedicated internal loopback RPC secret shared between Next.js and collab-server.
# Must be EXACTLY 64 hexadecimal characters (32 cryptographically random bytes).
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_RPC_SECRET="replace-with-64-hex-characters-generated-from-32-random-bytes"

# ==============================================================================
# 2. PUBLIC CLIENT CONFIGURATION (Browser-safe — bundled at Next.js build time)
# ==============================================================================

# [OPTIONAL in dev | REQUIRED in production] Public base URL of the Next.js web application.
# Used for WebSocket origin verification and application metadata.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# [OPTIONAL in dev | REQUIRED in production if WS differs from :1234]
# Public WebSocket URL for the dedicated Yjs collaboration server.
# In production behind TLS, use wss:// (e.g. "wss://your-app.example.com").
# If omitted in dev, the client derives ws(s)://<window.location.hostname>:1234.
NEXT_PUBLIC_COLLAB_WS_URL="ws://localhost:1234"

# ==============================================================================
# 3. DEDICATED COLLABORATION SERVER CONFIGURATION (Private server runtime)
# ==============================================================================

# [OPTIONAL] Port for the dedicated Yjs WebSocket collaboration server (default: 1234)
COLLAB_PORT=1234

# [OPTIONAL] Bind host interface for collaboration server (default: dual-stack / all interfaces)
# COLLAB_HOST="127.0.0.1"

# [OPTIONAL] Comma-separated list of allowed browser Origin headers for WebSocket upgrades.
# Defaults to localhost origins + NEXT_PUBLIC_APP_URL when omitted.
# COLLAB_ALLOWED_ORIGINS="https://your-app.example.com"

# [OPTIONAL] Milliseconds allowed for client first-message JWT auth handshake (default: 5000)
# COLLAB_AUTH_TIMEOUT_MS=5000

# [OPTIONAL] Grace period (ms) before destroying an empty room in memory (default: 30000)
# COLLAB_CLEANUP_GRACE_MS=30000

# ==============================================================================
# 4. REDIS MULTI-INSTANCE COORDINATION (Private server runtime)
# ==============================================================================

# [OPTIONAL] Enable or disable Redis pub/sub & distributed locks (default: true).
# Set to "false" for single-instance deployments where cross-node pub/sub is unused.
REDIS_ENABLED="true"

# [OPTIONAL when REDIS_ENABLED=false | REQUIRED when REDIS_ENABLED=true in production]
# Redis TCP/TLS connection string (redis:// or rediss://).
REDIS_URL="redis://localhost:6379"

# ==============================================================================
# 5. DOCKER PRODUCTION RUNTIME (Used by docker-compose.prod.yml / prod-entrypoint)
# ==============================================================================

# [OPTIONAL] Public host ports mapped by docker-compose.prod.yml (defaults shown)
# APP_PORT=3000
# COLLAB_PUBLIC_PORT=1235

# [REQUIRED only when running self-hosted postgres in docker-compose.prod.yml]
# POSTGRES_USER="postgres"
# POSTGRES_PASSWORD="change-this-to-a-strong-database-password"
# POSTGRES_DB="collab_workspace"
