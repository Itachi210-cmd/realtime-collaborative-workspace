generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  EDITOR
  COMMENTER
  VIEWER
}

model User {
  id               String            @id @default(cuid())
  name             String
  email            String            @unique
  passwordHash     String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  ownedWorkspaces  Workspace[]       @relation("WorkspaceOwner")
  memberships      WorkspaceMember[]
  createdPages     Page[]
  comments         Comment[]
  versionSnapshots VersionSnapshot[]

  @@map("users")
}

model Workspace {
  id        String            @id @default(cuid())
  name      String
  ownerId   String
  owner     User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  members   WorkspaceMember[]
  pages     Page[]

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role      @default(EDITOR)
  joinedAt    DateTime  @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
  @@map("workspace_members")
}

model Page {
  id               String            @id @default(cuid())
  workspaceId      String
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parentPageId     String?
  parentPage       Page?             @relation("PageHierarchy", fields: [parentPageId], references: [id], onDelete: Cascade)
  childPages       Page[]            @relation("PageHierarchy")
  title            String
  content          Json?
  documentState    DocumentState?
  comments         Comment[]
  versionSnapshots VersionSnapshot[]
  createdById      String?
  createdBy        User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([workspaceId])
  @@index([parentPageId])
  @@index([createdById])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, parentPageId, createdAt])
  @@map("pages")
}

model DocumentState {
  id           String   @id @default(cuid())
  pageId       String   @unique
  page         Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  yjsState     Bytes
  stateVersion Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("document_states")
}

model Comment {
  id         String    @id @default(cuid())
  pageId     String
  page       Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  authorId   String
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body       String
  anchor     Json?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([pageId])
  @@index([authorId])
  @@index([pageId, createdAt])
  @@map("comments")
}

model VersionSnapshot {
  id          String   @id @default(cuid())
  pageId      String
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  label       String?
  description String?
  yjsState    Bytes
  content     Json?
  wordCount   Int?
  isAutomatic Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([pageId])
  @@index([createdById])
  @@index([pageId, createdAt(sort: Desc)])
  @@map("version_snapshots")
}
